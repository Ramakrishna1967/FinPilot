# Optional — narration uses Groq first, Claude second, deterministic templates offline.
# Just add ONE key; no code changes needed.
GROQ_API_KEY=
# Any Groq chat model, e.g. openai/gpt-oss-120b, qwen/qwen3.6-27b, openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
ANTHROPIC_API_KEY=
# Single Claude model for all agent narration (detection stays deterministic Python).
CLAUDE_MODEL=claude-sonnet-4-5-20250929
# Seconds per simulated day tick.
TICK_SECONDS=3.5
# 0-based index into the 90-day window where the live loop starts (77 = day 78,
# so trailing averages exist and findings surface within seconds of opening).
START_DAY_IDX=77
